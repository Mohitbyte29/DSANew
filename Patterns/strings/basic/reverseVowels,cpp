class Solution {
public:
    string reverseVowels(string s) {
        int n = s.size();
        string res = "";
        int i = 0, j = n - 1;
        while(i <= j){
            if(strchr("aeiouAEIOU", s[i]) && strchr("aeiouAEIOU", s[j])){
                char temp = s[i];
                s[i] = s[j];
                s[j] = temp;
                j--;
                i++;
                continue;
            }
            else if(strchr("aeiouAEIOU", s[i])){
                j--;
                continue;
            }
            else if(strchr("aeiouAEIOU", s[j])){
                i++;
                continue;
            }
        }
        return s;
    }
};